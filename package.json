    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.4",
    "vitest": "^5.0.3"
